# Local environment and credentials; commit only sanitized examples
.env
.env.*
!.env.example
!.env.*.example
!.env.template
*.local
*.key
*.p12
*.pfx

# Logs and crash dumps
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Editor and operating-system files
.idea/
.vscode/*
