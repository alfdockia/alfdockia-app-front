.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnpm-store/

# Angular / Nx builds and local caches
/dist/
/out-tsc/
/tmp/
/temp/
/nxcache/
.nx/
.angular/
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Test coverage, reports and browser sessions
coverage/
.nyc_output/
test-results/
e2e-output/
playwright-report/
playwright-data/
blob-report/
